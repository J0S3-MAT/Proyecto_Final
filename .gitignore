# 1. Directorios y archivos de compilación de CMake (¡Lo más importante!)
build/
build-*/
out/
.cmake/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json

# 2. Archivos autogenerados por Qt (MOC, UIC, RCC) 
# (Normalmente se quedan en build/, pero se incluyen por seguridad)
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.qmlc
*.jsc
.qmake.stash

# 3. Configuraciones locales de IDEs (Qt Creator / VS Code)
CMakeLists.txt.user
CMakeLists.txt.user.*
*.pro.user
*.pro.user.*
.vscode/

# 4. Binarios y ejecutables compilados
*.exe
*.dll
*.so
*.dylib
*.a
*.o
*.obj

# 5. Archivos temporales del sistema operativo
Thumbs.db
.DS_Store
